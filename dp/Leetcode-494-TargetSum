//Approach - 1
class Solution {

  public int findTargetSumWays(int[] nums, int target) {
    // start from index 0 with current sum = 0
    return solve(0, 0, nums, target);
  }

  int solve(int index, int sum, int[] nums, int target) {

    // BASE CASE — used all numbers
    if (index == nums.length) {
      // did we hit the target? yes = 1 way, no = 0 ways
      return (sum == target) ? 1 : 0;
    }

    // CHOICE 1 — put + in front of nums[index]
    int add = solve(index + 1, sum + nums[index], nums, target);

    // CHOICE 2 — put − in front of nums[index]
    int sub = solve(index + 1, sum - nums[index], nums, target);

    // total ways = ways with + PLUS ways with −
    return add + sub;
  }
}
//TC O(2^N)  SC O(1)


//Approach - 2

class Solution {

  public int findTargetSumWays(int[] nums, int target) {
    // HashMap — key="index,sum", value=ways from that state
    Map<String, Integer> memo = new HashMap<>();
    return solve(0, 0, nums, target, memo);
  }

  int solve(int index, int sum,
            int[] nums, int target,
            Map<String, Integer> memo) {

    // BASE CASE — used all numbers
    if (index == nums.length)
      return (sum == target) ? 1 : 0;

    // create unique key for this state
    String key = index + "," + sum;

    // CHECK NOTEBOOK — already solved this state?
    if (memo.containsKey(key)) return memo.get(key);

    // CHOICE 1 — add nums[index]
    int add = solve(index+1, sum+nums[index], nums, target, memo);

    // CHOICE 2 — subtract nums[index]
    int sub = solve(index+1, sum-nums[index], nums, target, memo);

    // STORE result in map
    memo.put(key, add + sub);
    return memo.get(key);
  }
}

TC O(N * S)
SC O(n*S)



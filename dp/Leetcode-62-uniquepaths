// Approach - 4 (Space Optimize ) (2-D - ONe-D)
// maintain prev row and current row
class Solution {
    public int uniquePaths(int m, int n) {
        int prev[] = new int[n+1];
        Arrays.fill(prev, 1); // fill the base case for entire row
        prev[0] = 0;
        for(int i= 2; i<=m ; i++){
            int curr[] = new int[n+1];
            curr[1] = 1;
            for(int j = 2; j<=n ; j++){
                // prev[j] = goes up
                // curr[j-1] = goes left
                curr[j] = prev[j] + curr[j-1];
            }
            prev = curr;
        }
        return prev[n]; // store the final answer
    }
}


// Approach - 4 Space Optimize - Best Solution
// Instead of maintaining the entire dp array
// we maintain first = dp[i+1] and second = dp[i+2], 
// come down to SC O(1)
class Solution {
    public int rob(int[] nums) {

        int n  = nums.length;
        if(n== 1){
            return nums[0];
        }
        int first = 0; // dp[n] = 0 (i+2)
        int second = nums[n-1]; // (i+1) store last house to rob
        int current = 0;
        for(int i = n-2; i>=0; i--){
            // Choice - 1 rob
            int rob = nums[i] + first;
            // Choice - 2 skip
            int skip = second;
            current = Math.max(rob, skip);
            first = second;
            second = current;
        }
        return current;
    }
}


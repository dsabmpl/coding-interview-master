
// Approach - 4 Space Optimize Approach TC O(N) SC O(1)
class Solution {
    public int fib(int n) {
        // Edge case
        if(n<=1){
            return n;

        }
        // base case
        int first = 0;
        int second = 1;
        int third = 0;
        for(int i = 2; i<=n; i++){
            third = first + second;
            first = second;
            second = third;
        }
        return third;
    }

}

// Approach - 4 Space Optimise Approach
// TC O(MXN) SC O(N)
class Solution {
    public int longestCommonSubsequence(String text1, String text2) {
        int m = text1.length();
        int n = text2.length();
        int []prev = new int[n+1]; // Prev Row
        for(int i = 1; i<=m ; i++){
            int [] curr = new int[n+1]; // Current Row
            for(int j = 1; j<=n ; j++){
                // Match Case
                if(text1.charAt(i-1) == text2.charAt(j-1)){
                    curr[j] = 1 + prev[j-1];
                }
                else{
                    // No Match case
                   curr[j] = Math.max( prev[j], curr[j-1]);
                }
            }
            prev = curr; 
        }
        return prev[n];
    }
}



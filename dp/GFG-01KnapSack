//Approach - 1 Recursion

class Solution {
    public int knapsack(int W, int val[], int wt[]) {
        // code here
        return helper(0, W, wt, val);
    }
    
     int helper(int i, int W,int[] wt,int[] val){

    // no items left OR bag is full
    if (i == wt.length || W == 0) return 0;

    // SKIP item i — don't take it
    int skip = helper(i+1, W, wt, val);

    // PICK item i — only if it fits in bag
    int pick = 0;
    if (wt[i] <= W)
      pick = val[i] + helper(i+1, W-wt[i], wt, val);

    // return whichever gives more value
    return Math.max(pick, skip);
  }
}
/*
Time
O(2^n)
Space
O(n)
*/
//Approach - 2 Memoization

class Solution {
  public int knapsack(int W, int[] val, int[] wt) {
    int n = wt.length;
    int[][] dp = new int[n][W+1];
    for(int[] r: dp) java.util.Arrays.fill(r,-1);
    return solve(0, W, wt, val, dp);
  }

  static int solve(int i,int W,int[]wt,int[]val,int[][]dp){
    if (i==wt.length || W==0) return 0;

    // already computed? return instantly!
    if (dp[i][W] != -1) return dp[i][W];

    int skip = solve(i+1, W, wt, val, dp);
    int pick = 0;
    if (wt[i] <= W)
      pick = val[i] + solve(i+1,W-wt[i],wt,val,dp);

    // store in dp array before returning
    dp[i][W] = Math.max(pick, skip);
    return dp[i][W];
  }
}
/*
Time
O(n×W)

Space
O(n×W)
*/

//Approach -3 Tabulation

class Solution {
  static int knapsack(int W, int[] val, int[] wt) {
    int n = wt.length;

    // dp[i][w] = max value using first i items, capacity w
    int[][] dp = new int[n+1][W+1];

    // base: row 0 and col 0 already 0 (Java default)

    for(int i=1; i<=n; i++){
      for(int w=0; w<=W; w++){

        // item too heavy — must skip
        if(wt[i-1] > w)
          dp[i][w] = dp[i-1][w];

        // can pick or skip — take the best
        else
          dp[i][w] = Math.max(
            dp[i-1][w],                        // skip
            val[i-1] + dp[i-1][w-wt[i-1]]   // pick
          );
      }
    }

    
    return dp[n][W];
  }
}
/*
Time
O(n×W)

Space
O(n×W)
*/

//Approach -4 Space Optimise 

class Solution {
  static int knapsack(int W, int[] val, int[] wt) {
    int n = wt.length;

    // ONE row instead of n+1 rows
    int[] dp = new int[W+1];
    // all zeros by default = base case done!

    // process each item one by one
    for(int i=0; i<n; i++){

      // ⚠️ RIGHT TO LEFT — critical!
      for(int w=W; w>=wt[i]; w--){

        // same formula as tabulation
        dp[w] = Math.max(
          dp[w],              // skip item i
          val[i] + dp[w-wt[i]] // pick item i
        );
      }
    }

    // dp[W] = answer!
    return dp[W];
  }
}
/*
TIME
O(n×W)

SPACE
O(W) */

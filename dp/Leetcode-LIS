// Approach - 4 Space Optimise Approach - TC O(N Log N) SC O(N)
class Solution {
    public int lengthOfLIS(int[] nums) {
        // tail array - LIS Element Store
        int tails [] = new int[nums.length]; // Space O(N)
        // traverse each element of nums one by one
        int tailSize = 0;
        for(int num : nums){ // O(N)
            // Binary Search - Log N
            int low = 0; 
            int high = tailSize;
            while(low < high){
                int mid = (low + high)/2;
                if(tails[mid] < num){
                    low = mid + 1;
                }
                else{
                    high = mid ;
                }
            }
            tails[low] = num;
            if(low == tailSize){
                tailSize++;
            }
 
        }
        return tailSize; // LIS Length
    }
}


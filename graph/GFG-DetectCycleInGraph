class Solution {
    public boolean isCyclic(int V, int[][] edges) {
        // code here
        ArrayList<ArrayList<Integer>> adjList = new ArrayList<>();
        for(int i = 0; i<V; i++){
            adjList.add(new ArrayList<>());
        }
        for(int edge[] : edges){
            int u = edge[0];
            int v = edge[1];
            adjList.get(u).add(v); // directed u->v
        }
        boolean [] visited = new boolean[V];
        boolean []pathVisited = new boolean[V];
        // traverse each vertex one by one
        for(int i = 0; i<V; i++){
            if(!visited[i]){
                if(dfsHelper(i, adjList, visited, pathVisited)){
                    // cycle found
                    return true;
                }
            }
        }
        return false;
    }
    boolean dfsHelper(int vertex , ArrayList<ArrayList<Integer>> adjList
    , boolean [] visited, boolean []pathVisited){
        visited[vertex] = true;
        pathVisited[vertex] = true;
        for(int neighbour : adjList.get(vertex)){
            if(!visited[neighbour]){
                if(dfsHelper(neighbour, adjList, visited, pathVisited)){
                    return true;
                }
            }
            else if(pathVisited[neighbour]){
                return true; // Cycle found
            }
        }
        pathVisited[vertex] = false;
        return false; 
    }
}












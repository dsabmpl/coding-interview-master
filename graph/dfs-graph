class Solution {
    public ArrayList<Integer> dfs(ArrayList<ArrayList<Integer>> adj) {
        // code here
        // number of vertex
        int V = adj.size();
        ArrayList<Integer> dfsResult = new ArrayList<>();
        boolean[] visited = new boolean[V]; // all fill with false value (nothing visited)
        int startVertex = 0;
        dfsHelper(startVertex, visited, adj, dfsResult);
        return dfsResult;
        
        
    }
    void dfsHelper(int vertex, boolean[] visited, 
    ArrayList<ArrayList<Integer>> adj, ArrayList<Integer> dfsResult){
        visited[vertex] = true;
        dfsResult.add(vertex);
        for(int i = 0; i<adj.get(vertex).size(); i++){
            if(!visited[adj.get(vertex).get(i)]){
                dfsHelper(adj.get(vertex).get(i),
                visited, adj, dfsResult);
            }
        }
    }
    
    
    
}

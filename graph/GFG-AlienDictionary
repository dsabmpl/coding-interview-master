class Solution {
    public String findOrder(String[] words) {
        // code here
        // Find Alphabets in words (Alien Lang.)
        int V = 0;
        // Traverse word by word
        for(String word : words){
            // for one word get the chars
            for(char ch : word.toCharArray()){
                int ascii = (ch  - 'a') + 1 ; // char to number 
                V = Math.max(V, ascii); 
            }
        }
        // check existance of letter in word
        boolean exist[] = new boolean[V];
        for(String word : words){
            for(char ch : word.toCharArray()){
                exist[ch - 'a'] = true; // mark the letter is exist in word
            }
        }
        // Build the Graph
        List<List<Integer>> adjList = new ArrayList<>();
        for(int i = 0; i<V; i++){
            adjList.add(new ArrayList<>());
        }
        // compare each word with the next word on the right
        for(int i = 0; i<words.length-1 ; i++){
            String word1 = words[i]; // get the current word
            String word2 = words[i + 1]; // get the next word
            int len = Math.min(word1.length(), word2.length()); // get the shorter word
            boolean isMisMatchFound = false;
            for(int j = 0; j<len; j++){
                // if both letter are not matched
                if(word1.charAt(j) != word2.charAt(j)){
                    // first difference i get it, now time to prepare u->v (topo sort)
                    int u = word1.charAt(j) - 'a';
                    int v = word2.charAt(j) - 'a';
                    adjList.get(u).add(v); // u->v connection build
                    isMisMatchFound = true;
                    break;
                }
                
            } // j loop ends
            if(!isMisMatchFound && word1.length() > word2.length()){
                return ""; // Invalid Input
            }
        }
            // Maintain inDegree 
            int inDegree[] = new int[V];
            for(int u = 0; u<V ; u++){
                for(int v : adjList.get(u)){
                    inDegree[v]++;
                }
            }
            // Process it
            Queue<Integer> queue = new LinkedList<>();
            for(int i = 0; i<V; i++){
                if(exist[i] && inDegree[i]==0){
                    queue.add(i);
                }
            }
            StringBuilder result = new StringBuilder();
            while(!queue.isEmpty()){
                int ch = queue.poll();
                result.append((char)(ch + 'a')); 
                // vertex (index) convert back into char (letter)
                for(int neighbour : adjList.get(ch)){
                    inDegree[neighbour]--;
                    if(inDegree[neighbour] == 0){
                        queue.add(neighbour);
                    }
                }
            }
            for(int i = 0 ; i<V ; i++){
                if(exist[i] && inDegree[i]!=0){ // Cycle Case
                    return "";
                }
            }
            return result.toString();
        }
        
    }








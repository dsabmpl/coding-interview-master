class Solution {
    public int maxSubArray(int[] nums) {
        int maxSum = nums[0];
        int sum = 0;
        for(int i = 0; i<nums.length; i++){
            sum = sum + nums[i];
            sum = Math.max(sum , nums[i]); // Restart
            maxSum = Math.max(maxSum , sum); 
        }
        return maxSum;

    }
}

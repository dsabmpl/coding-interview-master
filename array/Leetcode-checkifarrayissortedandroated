class Solution {
    public boolean check(int[] nums) {
        int count = 0;
        for(int i = 0; i<nums.length-1; i++){
            // is not sorted 
            //, some where so it means might be some rotation
            if(nums[i] > nums[i+1]){
                count++;
            }
        }
        if(nums[nums.length-1]>nums[0]){
            count++;
        }
        return count<=1;
    }
}

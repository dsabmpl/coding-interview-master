class Solution {
    int preIndex = 0;
    public TreeNode buildTree(int[] preorder, int[] inorder) { 
        Map<Integer , Integer> inorderIndex = new HashMap<>();
        for(int i = 0;i<inorder.length;i++){
            inorderIndex.put(inorder[i] , i);
        }
        return buildTree(preorder , 0 , inorder.length - 1, inorderIndex);
    }
    TreeNode buildTree(int[] preorder , int startingIndex , int endIndex , 
    Map<Integer , Integer> inorderIndex){
        if(startingIndex > endIndex){
            return null;
        }
        int val = preorder[preIndex++];
        TreeNode root = new TreeNode(val);
        int index = inorderIndex.get(val);
        root.left = buildTree(preorder , startingIndex , index - 1 , inorderIndex);
        root.right = buildTree(preorder , index + 1 , endIndex , inorderIndex);
        return root;
    }
}

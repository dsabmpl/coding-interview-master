class Solution {
    Node pre;
    Node suc;
    public ArrayList<Node> findPreSuc(Node root, int key) {
        // code here
        ArrayList<Node> list = new ArrayList<>();
        inorder(root, key);
        list.add(pre);
        list.add(suc);
        return list;
        
    }
    void inorder(Node root, int key){
        if(root == null){
            return ;
        }
        inorder(root.left, key);
        if(root.data < key){
            pre = root;
        }
        else if(root.data > key && suc == null){
            suc = root;
        }
        inorder(root.right, key);
    }
}

// Approach - 2 Greedy Algo TC O(N log N ) SC O(1)
class Solution {
    public int findContentChildren(int[] g, int[] s) {
        Arrays.sort(g);  // N Log N
        Arrays.sort(s);
        // Maintain 2 Pointer
        int i = 0;
        int j = 0;
        // maintain count
        int count = 0;
        while(i<g.length && j<s.length){
            if(s[j]>=g[i]){
                i++;
                j++;
                count++;
            }
            else{
                j++;
            }
        }
        return count;

    }
}



// Approach - 2 Greedy Algo TC O(N) SC O(1)
class Solution {
    public boolean lemonadeChange(int[] bills) {
            // count five and ten
            int five = 0;
            int ten = 0 ;
            for(int bill : bills){
                if(bill == 5){
                    five++;
                }
                else if(bill == 10){
                    if(five>=1){
                        five--;
                        ten++;
                    }
                    else{
                        return false;
                    }
                }
                else{
                    // Rs 20 
                    // Option 1 - ten + five
                    if(ten>=1 && five>=1){
                        ten--;
                        five--;
                    }
                    // only five (3)
                    else if(five>=3){
                        five = five - 3;
                    }
                    else{
                        return false;
                    }
                }
            }
            // all bill settle
            return true;
    }
}

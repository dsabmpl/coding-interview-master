class Solution {
    public boolean canJump(int[] nums) {
        int maxReach = 0;
        for(int i = 0; i<nums.length; i++){
            if(i>maxReach){
                // we can't go further (stuck)
                return false;
            }
            // update the maxReach 
            maxReach = Math.max(i + nums[i], maxReach);
        }
        return true; // cross the array
    }
}
